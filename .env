# 3hmind 配置文件
# LLM API 设置 (支持 OpenAI / DeepSeek 等兼容接口)
LLM_API_KEY=sk-81ad204238b34e90b9217aec71dc9248
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
